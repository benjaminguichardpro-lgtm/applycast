# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → Database → Connection string (URI, "Session pooler"), used only by drizzle-kit migrations
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public URL of the app (magic-link redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Transcripts (supadata.ai → Dashboard → API key)
SUPADATA_API_KEY=

# AI providers (platform.openai.com → API keys · console.anthropic.com later)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider and model per pipeline step (provider: openai | anthropic)
LLM_EXTRACT_PROVIDER=openai
LLM_EXTRACT_MODEL=gpt-6-luna
LLM_VERDICT_PROVIDER=openai
LLM_VERDICT_MODEL=gpt-6.1-terra

# Optional: own provider/model for later steps (adapt, check, plan, expand). Unset = same as the verdict step.
# LLM_ADAPT_PROVIDER=
# LLM_ADAPT_MODEL=
# LLM_CHECK_PROVIDER=
# LLM_CHECK_MODEL=
# LLM_PLAN_PROVIDER=
# LLM_PLAN_MODEL=
# LLM_EXPAND_PROVIDER=
# LLM_EXPAND_MODEL=

# Day-7 check-in emails (resend.com → API Keys). RESEND_FROM must be on a domain verified in Resend;
# without one, Resend only delivers to your own account email (default sender: onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM=
# Where messages from the Contact page are delivered (needs RESEND_API_KEY). Until a domain is verified in Resend,
# use the email of your Resend account.
CONTACT_EMAIL=
# Server-only. Supabase → Project Settings → API → service_role / secret key. Used only by the cron job. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <value>".
CRON_SECRET=

# Billing (Stripe, test mode first). Dashboard → Developers → API keys / Product catalog / Webhooks.
STRIPE_SECRET_KEY=
# The recurring $19/month price of the "Applycast Pro" product (starts with price_).
STRIPE_PRICE_ID=
# The recurring $190/year price (10 months for 12) of the same product, same benefits as the monthly one.
STRIPE_PRICE_ID_ANNUAL=
# Signing secret of the webhook endpoint (local: printed by `stripe listen`, starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# Two hosts, one deployment: the landing (MARKETING_HOST) and the app (APP_HOST). Leave both empty to serve everything
# from one host (the landing is then at "/"). NEXT_PUBLIC_SITE_URL above is the app's URL; this one is the landing's.
# Local: APP_HOST=app.localhost:3100, MARKETING_HOST=localhost:3100 (browsers resolve *.localhost to your machine).
NEXT_PUBLIC_MARKETING_URL=http://localhost:3100
APP_HOST=
MARKETING_HOST=

# Ask for acceptance of the terms (and the "start now" acknowledgement for consumers) at Stripe Checkout.
# Set to 1 only after adding the Terms URL (https://<landing>/terms) in the Stripe Dashboard: Settings -> Public details.
STRIPE_COLLECT_TERMS=
